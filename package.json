{
  "name": "moodle-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Moodle with interactive Microsoft SSO authentication and course resource streaming",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moodle-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx test/integration.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "playwright",
    "sso",
    "education"
  ],
  "author": "Carlos Henrique",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "playwright": "^1.58.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
